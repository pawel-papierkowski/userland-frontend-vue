# npm defaults for this project to reduce supply-chain risk.
# Many of these only affect NEW installs; the committed package-lock.json
# already pins every currently-installed dependency.

# Pin exact versions when adding new dependencies (no ^ or ~). This prevents
# npm from silently installing newer minor/patch releases during `npm ci`.
save-exact=true

# Always generate and maintain the lockfile.
package-lock=true

# Fail installation if the Node version does not satisfy `engines` in
# package.json, keeping installs predictable.
engine-strict=true

# Run a security audit on every install.
audit=true

# Stop showing the funding nag message.
fund=false